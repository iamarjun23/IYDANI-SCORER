{
  "name": "iydani-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IYDANI API — accounts, teacher profiles, scores, bookings. Runs as a Lambda behind API Gateway; runs as a plain server locally.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "migrate": "node tools/migrate.mjs",
    "migrate:status": "node tools/migrate.mjs --status",
    "package": "node tools/package.mjs",
    "test": "node --test tests/",
    "db:url": "node tools/db-url.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/aws-lambda": "^5.1.0",
    "aws-jwt-verify": "^4.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
